<!-- PRIMARY test layer: real HTTP against a real SQLite file (no Docker needed). -->
<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <OutputType>Exe</OutputType>          <!-- xUnit v3 test projects are executables -->
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="xunit.v3" Version="3.2.2"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.1"/>
        <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.15"/>
        <PackageReference Include="Bogus" Version="35.6.5"/>
        <PackageReference Include="FluentAssertions" Version="7.0.0"/>
        <PackageReference Include="coverlet.collector" Version="10.1.0"/>
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\Server\Cuadre.Api\Cuadre.Api.csproj"/>
        <ProjectReference Include="..\..\Server\Cuadre.Contracts\Cuadre.Contracts.csproj"/>
    </ItemGroup>

</Project>
