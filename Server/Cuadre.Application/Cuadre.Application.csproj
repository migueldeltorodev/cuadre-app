<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Dapper" Version="2.1.89"/>
        <PackageReference Include="dbup-sqlite" Version="6.0.4"/>
        <PackageReference Include="FluentResults" Version="4.0.0"/>
        <PackageReference Include="FluentValidation" Version="12.2.0"/>
        <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0"/>
        <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.15"/>
    </ItemGroup>

    <!-- Glob: every new DbUp script is embedded automatically (no per-file entries). -->
    <ItemGroup>
        <None Remove="Database\Scripts\*.sql"/>
        <EmbeddedResource Include="Database\Scripts\*.sql"/>
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Cuadre.Application.Tests"/>
    </ItemGroup>

    <!-- NO ProjectReference to Cuadre.Contracts: mapping lives in the Api layer. -->

</Project>
